# ANIME SOUL — environment variables (PLACEHOLDERS ONLY — never commit real values)
# On Heroku: Settings → Config Vars. Locally: copy to .env (git-ignored).

# --- Telegram (required) ---
API_ID=1234567                      # from https://my.telegram.org → API development tools
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your-bot-token-from-BotFather

# --- MongoDB (required) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=file_share_bot

# --- Admins ---
OWNER_ID=111111111                  # your numeric Telegram ID (send /id to the bot)
ADMIN_IDS=                          # optional extra admins, comma-separated

# --- Channels (required for automation) ---
STORAGE_CHANNEL_ID=-100xxxxxxxxxx   # private channel where files are stored
POST_CHANNEL_ID=-100xxxxxxxxxx      # public ANIME SOUL channel for announcements
TEST_CHANNEL_ID=                    # optional private channel for /testupload publish (safe test posts)
CHANNEL_NAME=ANIME SOUL

# --- Force subscription ---
FSUB_CHANNELS=                      # comma-separated: -100xxxxxxxxxx,@yourchannel
FSUB_JOIN_REQUEST=false             # true = private channels using join requests
FSUB_JOIN_REQUEST_TTL_HOURS=72
FSUB_LEGACY_LINKS=false             # true = also require FSUB for old share links

# --- Process ---
ROLE=all                            # all | bot | pipeline
DRY_RUN=true                        # default true: detect + report only, never upload/post
DRY_RUN_PROCESS=false               # true = dry run also downloads + FFmpeg-checks (still no upload)
LOG_LEVEL=INFO
LOG_JSON=false

# --- Monitor ---
POLL_INTERVAL_SECONDS=600
SOURCE_CHECK_INTERVAL_SECONDS=300
LOOKAHEAD_HOURS=48
LOOKBACK_HOURS=72
# After downtime, look back to the last successful check, but at most this many hours.
RECONCILE_MAX_HOURS=168
# Alert admins after this many failed checks of one feed in a row (feeds back off exponentially).
FEED_ALERT_AFTER_FAILURES=5
DELAY_ALERT_MINUTES=180
SOURCE_GIVEUP_HOURS=168
AUTO_TRACK_SEQUELS=true
AUTO_DISCOVER_AIRING_ANIME=true     # auto-add currently airing TV/ONA anime from AniList (schedule only, no videos)
AUTO_DISCOVER_MAX_PAGES=4           # 50 most popular airing anime per page (1-10)
FEED_DETECT_RELEASES=true           # new items in authorized RSS/JSON feeds also create episodes
JIKAN_FALLBACK=true

# --- Authorized sources ---
ALLOWED_SOURCE_HOSTS=               # e.g. cdn.yourpartner.com,files.yourserver.com
ALLOW_HTTP_SOURCES=false
LOCAL_SOURCE_ROOTS=                 # VPS only, e.g. /srv/anime-library
# PARTNER_FEED_AUTH=Bearer xxxxx    # referenced by /sources add_rss|add_feed ... auth_env=PARTNER_FEED_AUTH

# --- Limits ---
MAX_FILE_SIZE_MB=2000
MIN_FILE_SIZE_MB=5
DOWNLOAD_TIMEOUT_SECONDS=3600
UPLOAD_TIMEOUT_SECONDS=3600
MAX_RETRIES=8
MAX_CONCURRENT_JOBS=1
JOB_LEASE_SECONDS=900
DOWNLOAD_DIR=/tmp/anime_soul
DISK_HEADROOM_MB=300                # keep this much free disk before downloading/encoding

# --- FFmpeg / video processing ---
PROCESS_MODE=auto                   # auto | copy | transcode | off
FFMPEG_REQUIRED=true                # block uploads if ffprobe is missing
FFMPEG_TIMEOUT_SECONDS=5400
FFMPEG_THREADS=2
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_AUDIO_CODEC=aac
FFMPEG_AUDIO_BITRATE=128k
OUTPUT_CONTAINER=mkv                # transcode output: mkv keeps subtitles, mp4 drops them
MAX_OUTPUT_HEIGHT=0                 # 0 = keep; 720 = downscale bigger files (needs CPU/RAM)
MIN_DURATION_SECONDS=30
MAX_DURATION_SECONDS=14400
REQUIRE_AUDIO=true
PROCESS_TELEGRAM_FILES=false        # true = /attach files are also downloaded + FFmpeg-checked

# --- Defaults ---
DEFAULT_QUALITY=1080p
DEFAULT_LANGUAGE=Japanese (English Sub)
PROTECT_CONTENT=false
PUBLIC_FILE_LINKS=true

# --- Daily airing timetable (IST). Off by default; in dry run it goes to admins only.
SCHEDULE_POST_ENABLED=false
SCHEDULE_POST_TIME=00:30
# Optional; defaults to POST_CHANNEL_ID.
SCHEDULE_CHANNEL_ID=
