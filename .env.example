# ANIME SOUL — environment variables (PLACEHOLDERS ONLY — never commit real values)
# On Heroku: Settings → Config Vars. Locally: copy to .env (git-ignored).

# --- Telegram (required) ---
API_ID=1234567                      # from https://my.telegram.org → API development tools
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your-bot-token-from-BotFather

# --- MongoDB (required) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=file_share_bot

# --- Admins ---
OWNER_ID=111111111                  # your numeric Telegram ID (send /id to the bot)
ADMIN_IDS=                          # optional extra admins, comma-separated

# --- Channels (required for automation) ---
STORAGE_CHANNEL_ID=-100xxxxxxxxxx   # private channel where files are stored
POST_CHANNEL_ID=-100xxxxxxxxxx      # public ANIME SOUL channel for announcements
CHANNEL_NAME=ANIME SOUL

# --- Force subscription ---
FSUB_CHANNELS=                      # comma-separated: -100xxxxxxxxxx,@yourchannel
FSUB_JOIN_REQUEST=false             # true = private channels using join requests
FSUB_JOIN_REQUEST_TTL_HOURS=72
FSUB_LEGACY_LINKS=false             # true = also require FSUB for old share links

# --- Process ---
ROLE=all                            # all | bot | pipeline
DRY_RUN=true                        # start in dry-run; set false when ready
LOG_LEVEL=INFO
LOG_JSON=false

# --- Monitor ---
POLL_INTERVAL_SECONDS=600
SOURCE_CHECK_INTERVAL_SECONDS=300
LOOKAHEAD_HOURS=48
LOOKBACK_HOURS=72
DELAY_ALERT_MINUTES=180
SOURCE_GIVEUP_HOURS=168
AUTO_TRACK_SEQUELS=true
JIKAN_FALLBACK=true

# --- Authorized sources ---
ALLOWED_SOURCE_HOSTS=               # e.g. cdn.yourpartner.com,files.yourserver.com
ALLOW_HTTP_SOURCES=false
LOCAL_SOURCE_ROOTS=                 # VPS only, e.g. /srv/anime-library
# PARTNER_FEED_AUTH=Bearer xxxxx    # referenced by /sources add_feed ... auth_env=PARTNER_FEED_AUTH

# --- Limits ---
MAX_FILE_SIZE_MB=2000
MIN_FILE_SIZE_MB=5
DOWNLOAD_TIMEOUT_SECONDS=3600
UPLOAD_TIMEOUT_SECONDS=3600
MAX_RETRIES=8
MAX_CONCURRENT_JOBS=1
JOB_LEASE_SECONDS=900
DOWNLOAD_DIR=/tmp/anime_soul

# --- Defaults ---
DEFAULT_QUALITY=1080p
DEFAULT_LANGUAGE=Japanese (English Sub)
PROTECT_CONTENT=false
PUBLIC_FILE_LINKS=true
